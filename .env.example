# Local container defaults. Replace both values before starting.
APP_ENV=production
SULTAN_SECRET_KEY=CHANGE_ME
SULTAN_INITIAL_ADMIN_PASSWORD=CHANGE_ME
SULTAN_COOKIE_SECURE=0

# Leave empty for local SQLite. Set a private Supabase PostgreSQL connection
# string to enable PostgreSQL mode; never commit the real value.
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=5
